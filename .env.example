# US Visa Bot Configuration
# Copy this file to .env and fill in your actual values

# Your credentials for https://ais.usvisa-info.com/
EMAIL=your.email@example.com
PASSWORD=your_password_here

# Locale/language setting - can be found in the URL when trying to reschedule
# Examples: 'fr-fr' for France, 'pt-br' for Brazil, 'en-us' for United States
LOCALE=en-us

# Schedule ID - found in the URL when trying to reschedule manually
# URL format: https://ais.usvisa-info.com/{LOCALE}/niv/schedule/{SCHEDULE_ID}/continue_actions
SCHEDULE_ID=12345678

# Facility ID - found in network calls when selecting a new date or inspecting the selector
# Examples: Paris is 44
# URL format: https://ais.usvisa-info.com/{LOCALE}/niv/schedule/{SCHEDULE_ID}/appointment/address/{FACILITY_ID}
FACILITY_ID=44

# Refresh delay in seconds between checks (optional, defaults to 3)
REFRESH_DELAY=3

# --- Optional: dry-run SMS notifications via AWS SNS ---
# If set, and the bot is run with --dry-run, it will send a direct-to-phone
# SMS (via SNS) instead of just logging when it finds a date it would have
# booked. Leave unset for no SMS notifications. Must be E.164 format
# (e.g. +15551234567).
NOTIFY_PHONE_NUMBER=

# AWS region SNS should publish from. On EC2 this can usually be left unset -
# the SDK picks up the instance's region automatically - but set it explicitly
# if you want to be sure, or if running outside EC2 (e.g. locally while testing).
AWS_REGION=us-east-1