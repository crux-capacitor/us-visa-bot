# US Visa Bot Configuration
# Copy this file to .env and fill in your actual values

# Your credentials for https://ais.usvisa-info.com/
EMAIL=your.email@example.com
PASSWORD=your_password_here

# Locale/language setting - can be found in the URL when trying to reschedule
# Examples: 'fr-fr' for France, 'pt-br' for Brazil, 'en-us' for United States
LOCALE=en-us

# Schedule ID - found in the URL when trying to reschedule manually
# URL format: https://ais.usvisa-info.com/{LOCALE}/niv/schedule/{SCHEDULE_ID}/continue_actions
SCHEDULE_ID=12345678

# Facility ID - found in network calls when selecting a new date or inspecting the selector
# Examples: Paris is 44
# URL format: https://ais.usvisa-info.com/{LOCALE}/niv/schedule/{SCHEDULE_ID}/appointment/address/{FACILITY_ID}
FACILITY_ID=44

# Refresh delay in seconds between checks (optional, defaults to 3)
REFRESH_DELAY=3

# --- Optional: SMS notifications via AWS SNS ---
# If set, sends a direct-to-phone SMS (via SNS) whenever the bot finds a
# date it would have booked (--dry-run) or actually books one (real run).
# Leave unset for no SMS notifications. Must be E.164 format (e.g.
# +15551234567).
NOTIFY_PHONE_NUMBER=

# AWS region SNS should publish from. On EC2 this can usually be left unset -
# the SDK picks up the instance's region automatically - but set it explicitly
# if you want to be sure, or if running outside EC2 (e.g. locally while testing).
AWS_REGION=us-east-1

# --- Optional: push notifications via ntfy (recommended - no AWS ---
# --- SMS/10DLC registration or telecom setup needed at all) ---
# If set, sends a push notification (via ntfy.sh, or your own self-hosted
# server) whenever the bot finds a date it would have booked (--dry-run) or
# actually books one (real run). Install the ntfy app and subscribe to this
# same topic name to receive it. Pick something hard to guess - public
# ntfy.sh topics are unauthenticated, so anyone who knows the name can read
# it. Leave unset to disable.
NTFY_TOPIC=

# Defaults to the public https://ntfy.sh - only set this if self-hosting.
NTFY_SERVER=https://ntfy.sh

# --- Optional: "still alive" heartbeat ---
# If set, sends a periodic "still running" notification via whichever
# channel(s) above are configured (ntfy and/or SMS), so you have a way to
# notice if the bot has silently died/hung rather than just waiting for an
# appointment notification that may never come. Accepts a bare number of
# hours (e.g. "3"), or a number with a unit suffix: "h" (hours), "m"
# (minutes), "s" (seconds) - e.g. "3h", "45m", "90s". Leave unset to disable.
HEARTBEAT_INTERVAL=3h

# --- Optional: where progress is persisted between restarts ---
# After a real (non-dry-run) booking, the bot writes its new currentBookedDate
# here so a restart - crash, systemd, reboot, manual restart - doesn't forget
# it and fall back to the --current value it was originally launched with
# (which could cause it to try re-booking a slot it already holds). Defaults
# to .us-visa-bot-state.json in the working directory - only set this if you
# need it somewhere else (e.g. a persistent volume separate from the code
# directory).
STATE_FILE_PATH=